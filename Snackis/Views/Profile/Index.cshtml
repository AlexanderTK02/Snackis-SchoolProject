@{
    ViewData["Title"] = "My profile";
}

<h1>My profile</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="mb-4">
    <img src="@Url.Action("Image", "Profile", new { id = ViewBag.UserId })"
         alt="Your profile picture" class="rounded"
         style="width:150px;height:150px;object-fit:cover;"
         onerror="this.style.display='none'" />
</div>

<form asp-action="Upload" method="post" enctype="multipart/form-data" class="col-md-6">
    <div class="mb-3">
        <label class="form-label">Upload a new picture (max 2 MB)</label>
        <input type="file" name="image" accept="image/*" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Upload</button>
</form>