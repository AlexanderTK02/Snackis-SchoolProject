@model Snackis.Models.Post

@{
    ViewData["Title"] = Model.Title;
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-secondary">← Back to posts</a>

    @if (User.Identity?.IsAuthenticated == true && User.Identity.Name != Model.User?.UserName)
    {
        <a asp-controller="Reports" asp-action="Create" asp-route-postId="@Model.Id"
           class="btn btn-outline-danger">Report post</a>

        <a asp-controller="Messages" asp-action="Conversation" asp-route-id="@Model.UserId"
           class="btn btn-outline-secondary">Message author</a>
    }

    @if (User.Identity?.Name == Model.User?.UserName)
    {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Edit</a>
    }

    @if (User.Identity?.Name == Model.User?.UserName || User.IsInRole("Admin"))
    {
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>
    }
</div>

<div class="card mb-3">
    <div class="card-body d-flex">
        <img src="@Url.Action("Image", "Profile", new { id = Model.UserId })"
             alt="@Model.User?.UserName" class="rounded me-3"
             style="width:80px;height:80px;object-fit:cover;"
             onerror="this.style.display='none'" />
        <div>
            <h2 class="card-title">@Model.Title</h2>
            <h6 class="card-subtitle mb-3 text-muted">
                @Model.Category?.Name · by @Model.User?.UserName · @Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")
            </h6>
            <p class="card-text">@Model.Content</p>
        </div>
    </div>
</div>

<h4>Comments</h4>

@{
    var comments = ViewBag.Comments as List<Snackis.Models.Comment> ?? new List<Snackis.Models.Comment>();
}

@if (!comments.Any())
{
    <p class="text-muted">No comments yet.</p>
}

@foreach (var comment in comments)
{
<div class="card mb-2">
    <div class="card-body d-flex">
        <img src="@Url.Action("Image", "Profile", new { id = comment.UserId })"
             alt="@comment.User?.UserName" class="rounded me-3"
             style="width:50px;height:50px;object-fit:cover;"
             onerror="this.style.display='none'" />
        <div>
            <h6 class="card-subtitle mb-2 text-muted">
                @comment.User?.UserName · @comment.CreatedAt.ToString("yyyy-MM-dd HH:mm")
            </h6>
            <p class="card-text">@comment.Text</p>
        </div>
    </div>
</div>
}

@if (User.Identity?.IsAuthenticated == true)
{
    <form asp-controller="Comments" asp-action="Create" method="post" class="mt-3 mb-4">
        <input type="hidden" name="postId" value="@Model.Id" />
        <div class="mb-3">
            <textarea name="text" class="form-control" rows="3" placeholder="Write a comment..." required></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Comment</button>
    </form>
}
else
{
    <p class="mt-3 mb-4">
        <a asp-area="Identity" asp-page="/Account/Login">Log in</a> to write a comment.
    </p>
}