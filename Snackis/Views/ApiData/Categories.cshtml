@model List<Snackis.ApiModels.ApiCategory>

@{
    ViewData["Title"] = "Categories (API)";
}

<h1>Categories</h1>

@if (Model == null)
{
    <div class="alert alert-danger">The API could not be reached.</div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>ParentCategoryId</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.Id</td>
                    <td>@c.Name</td>
                    <td>@c.ParentCategoryId</td>
                </tr>
            }
        </tbody>
    </table>
}